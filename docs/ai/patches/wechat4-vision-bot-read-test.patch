+def ocr_chat_title(img, geom, ctx):
+    """Read the WeChat header as a single line on light or dark themes."""
+    ctx.check()
+    gray = np.asarray(img.crop(geom["header"]).convert("L"))
+    if min(gray.shape) < 8:
+        return ""
+    if np.median(gray) < 128:
+        gray = cv2.bitwise_not(gray)
+    scaled = cv2.resize(gray, None, fx=3, fy=3, interpolation=cv2.INTER_CUBIC)
+    bordered = cv2.copyMakeBorder(scaled, 20, 20, 20, 20, cv2.BORDER_CONSTANT, value=255)
+    return watcher._tess_run(bordered, 7, tesseract_bin(), "chi_sim", 8000)
+
+
+def exact_chat_title(img, geom, ctx, target):
+    """Return the title only when it identifies the requested chat exactly."""
+    target_name = _clean_row_text(target)
+    if not target_name:
+        return ""
+    title = ocr_chat_title(img, geom, ctx)
+    if _split_group_title(title)[0] == target_name:
+        return title
+
+    # The list divider can drift on a maximized window. Recheck the usual title
+    # area without accepting an approximate match.
+    _, top, right, bottom = geom["header"]
+    scale = geom["s"]
+    left = round((watcher.GEOM["rail_w"] + watcher.GEOM["list_w"] - 2) * scale)
+    narrow_header = (left, top, min(right, left + round(195 * scale)), bottom)
+    if narrow_header[2] <= narrow_header[0]:
+        return ""
+    title = ocr_chat_title(img, {"header": narrow_header}, ctx)
+    return title if _split_group_title(title)[0] == target_name else ""
 
 
