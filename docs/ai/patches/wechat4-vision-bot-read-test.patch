+def ocr_chat_title(img, geom, ctx):
+    """Read the WeChat header as a single line on light or dark themes."""
+    ctx.check()
+    gray = np.asarray(img.crop(geom["header"]).convert("L"))
+    if min(gray.shape) < 8:
+        return ""
+    if np.median(gray) < 128:
+        gray = cv2.bitwise_not(gray)
+    scaled = cv2.resize(gray, None, fx=3, fy=3, interpolation=cv2.INTER_CUBIC)
+    bordered = cv2.copyMakeBorder(scaled, 20, 20, 20, 20, cv2.BORDER_CONSTANT, value=255)
+    return watcher._tess_run(bordered, 7, tesseract_bin(), "chi_sim", 8000)
 
 
