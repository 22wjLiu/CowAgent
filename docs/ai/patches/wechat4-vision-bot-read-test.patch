+LOCAL_CHAT_SECTIONS = {"群聊", "联系人", "最常使用", "最近使用"}
+SEARCH_RESULT_BOUNDARIES = ("更多", "搜索网络结果", "网络查找微信号")
+
+
+def select_exact_local_result(rows, target_name):
+    """Select a unique exact name before the dropdown's network results."""
+    section = ""
+    matches = []
+    for row in rows:
+        # The union variant is synthetic and may create a name not present in OCR.
+        words = {
+            _clean_row_text(text)
+            for source, text in row["src_texts"].items()
+            if source != "union"
+        }
+        if any(marker in word for marker in SEARCH_RESULT_BOUNDARIES for word in words):
+            break
+        headers = words.intersection(GROUP_HEADERS)
+        if headers:
+            section = next(iter(headers)) if len(headers) == 1 else ""
+            continue
+        if section in LOCAL_CHAT_SECTIONS and target_name in words:
+            matches.append((row, section))
+    else:
+        # The scan must reach the end of local results to check uniqueness.
+        return None
+    if len(matches) > 1:
+        raise ReplyAbort("row-ambiguous（本地搜索结果里有多个同名会话，未点击）")
+    return matches[0] if matches else None
+
+
+def find_exact_local_result(ctx, img, geom, target):
+    """Read the stable left-hand dropdown separately from the chat pane."""
+    target_name = _clean_row_text(target)
+    if not target_name:
+        return None
+    scale = geom["s"]
+    left = round((watcher.GEOM["rail_w"] + 11) * scale)
+    top = round(watcher.GEOM["rows_top"] * scale)
+    right = min(img.width, round((watcher.GEOM["rail_w"] + watcher.GEOM["list_w"] + 3) * scale))
+    bottom = min(img.height, top + round(310 * scale))
+    if right - left < 40 or bottom - top < 40:
+        return None
+    box = (left, top, right, bottom)
+    dark_background = bool(np.median(np.asarray(img.crop(box).convert("L"))) < 128)
+    rows = _ocr_rows(img, box, ctx, zoom=3, psms=(6, 11),
+                     include_orig=False, invert=dark_background)
+    match = select_exact_local_result(rows, target_name)
+    if match is None:
+        return None
+    row, section = match
+    log("  [下拉] 本地分区 %r 唯一精确匹配 %r" % (section, target))
+    return {
+        "text": target,
+        "section": section,
+        "x_click": min(right - 8, left + round(80 * scale)),
+        "y_click": round(row["y"]),
+        "img_ref": img,
+        "panel_box": box,
+        "row_box": (left, round(row["top"]), right, round(row["bottom"])),
+    }
+
