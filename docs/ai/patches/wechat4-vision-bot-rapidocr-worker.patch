diff --git a/rapidocr_worker.py b/rapidocr_worker.py
new file mode 100644
index 0000000..ab2180f
--- /dev/null
+++ b/rapidocr_worker.py
@@ -0,0 +1,162 @@
+# -*- coding: utf-8 -*-
+"""Serve screenshot crops to reply.py from one watcher-owned OCR process."""
+
+import hmac
+import http.client
+from http.server import BaseHTTPRequestHandler, HTTPServer
+import json
+import multiprocessing
+import os
+import secrets
+import threading
+
+import numpy as np
+
+ENV_PORT = "WECHAT4_RAPIDOCR_WORKER_PORT"
+ENV_TOKEN = "WECHAT4_RAPIDOCR_WORKER_TOKEN"
+_HOST = "127.0.0.1"
+_TIMEOUT = 5
+_MAX_IMAGE_BYTES = 32 * 1024 * 1024
+_MAX_RESULT_BYTES = 1024 * 1024
+
+
+class WorkerUnavailable(Exception):
+    """The local worker could not complete the OCR request."""
+
+
+def recognize(arr, detect):
+    """Send a contiguous BGR image without encoding or touching the filesystem."""
+    try:
+        port = int(os.environ[ENV_PORT])
+        token = os.environ[ENV_TOKEN]
+        height, width = arr.shape[:2]
+        conn = http.client.HTTPConnection(_HOST, port, timeout=_TIMEOUT)
+        try:
+            conn.request("POST", "/detect" if detect else "/line",
+                         body=memoryview(arr).cast("B"), headers={
+                             "Authorization": token,
+                             "Image-Height": str(height),
+                             "Image-Width": str(width),
+                         })
+            response = conn.getresponse()
+            if response.status != 200:
+                raise WorkerUnavailable("worker returned HTTP %d" % response.status)
+            body = response.read(_MAX_RESULT_BYTES + 1)
+            if len(body) > _MAX_RESULT_BYTES:
+                raise WorkerUnavailable("worker result too large")
+            data = json.loads(body)
+            return data["lines"], data["initMs"]
+        finally:
+            conn.close()
+    except (OSError, http.client.HTTPException, ValueError, KeyError) as exc:
+        raise WorkerUnavailable("worker request failed") from exc
+
+
+class _Handler(BaseHTTPRequestHandler):
+    def setup(self):
+        self.request.settimeout(_TIMEOUT)
+        super().setup()
+
+    def log_message(self, *_args):
+        pass
+
+    def do_POST(self):
+        if not hmac.compare_digest(self.headers.get("Authorization", "").encode("utf-8"),
+                                   self.server.token):
+            self.send_error(403)
+            return
+        try:
+            height = int(self.headers["Image-Height"])
+            width = int(self.headers["Image-Width"])
+            size = int(self.headers["Content-Length"])
+            if min(height, width) < 4 or size != height * width * 3 or size > _MAX_IMAGE_BYTES:
+                raise ValueError
+            if self.path not in ("/detect", "/line"):
+                raise ValueError
+        except (TypeError, ValueError):
+            self.send_error(400)
+            return
+
+        import ocr_engine
+
+        payload = self.rfile.read(size)
+        if len(payload) != size:
+            return
+        try:
+            arr = np.frombuffer(payload, dtype=np.uint8).reshape((height, width, 3)).copy()
+            started_ms = ocr_engine.stats()["initMs"]
+            model = ocr_engine._get_rapid()
+            init_ms = ocr_engine.stats()["initMs"] - started_ms
+            detect = self.path == "/detect"
+            lines = ocr_engine._infer_rapid(model, arr, detect)
+            body = json.dumps({"lines": lines, "initMs": init_ms}, ensure_ascii=False).encode("utf-8")
+        except Exception:
+            self.send_error(500)
+            return
+        self.send_response(200)
+        self.send_header("Content-Type", "application/json")
+        self.send_header("Content-Length", str(len(body)))
+        self.end_headers()
+        self.wfile.write(body)
+
+
+def _serve(ready, token, ocr_cfg):
+    import ocr_engine
+
+    def stop_with_parent():
+        multiprocessing.parent_process().join()
+        os._exit(0)
+
+    threading.Thread(target=stop_with_parent, daemon=True).start()
+    ocr_engine.configure(ocr_cfg)
+    with HTTPServer((_HOST, 0), _Handler) as server:
+        server.token = token.encode("ascii")
+        ready.send(server.server_port)
+        ready.close()
+        server.serve_forever()
+
+
+class RapidOCRWorker:
+    """Pass the same worker endpoint to successive read subprocesses."""
+
+    def __init__(self):
+        self._process = None
+        self._config = None
+        self._endpoint = {}
+
+    def environment(self, ocr_cfg):
+        if self._process is not None and self._process.is_alive() and self._config == ocr_cfg:
+            return self._endpoint
+        self.close()
+        ctx = multiprocessing.get_context("spawn")
+        receive, send = ctx.Pipe(duplex=False)
+        token = secrets.token_hex(32)
+        process = ctx.Process(target=_serve, args=(send, token, ocr_cfg), daemon=True)
+        try:
+            process.start()
+            self._process = process
+            send.close()
+            if not receive.poll(_TIMEOUT):
+                raise WorkerUnavailable("worker startup timed out")
+            self._endpoint = {ENV_PORT: str(receive.recv()), ENV_TOKEN: token}
+            self._config = ocr_cfg
+            return self._endpoint
+        except (OSError, EOFError, WorkerUnavailable):
+            self.close()
+            raise
+        finally:
+            receive.close()
+            send.close()
+
+    def close(self):
+        if self._process is not None:
+            if self._process.is_alive():
+                self._process.terminate()
+            self._process.join(timeout=1)
+            if self._process.is_alive():
+                self._process.kill()
+                self._process.join(timeout=1)
+            self._process.close()
+        self._process = None
+        self._config = None
+        self._endpoint = {}
