+#   uv pip install --python .venv\Scripts\python.exe -r requirements-rapidocr.txt --overrides overrides-rapidocr.txt
+#
+# Offline: add --offline --no-index --find-links <wheel dir>.
+# PP-OCRv6 small models ship inside the rapidocr wheel; other models go in models\.
