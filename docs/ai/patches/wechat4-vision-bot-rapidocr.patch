+# -*- coding: utf-8 -*-
+"""OCR engine switch: Tesseract subprocess (default) or in-process RapidOCR.
+
+tesseract: every OCR call starts tesseract.exe, which reloads chi_sim each time.
+rapidocr:  RapidOCR + ONNX Runtime run inside this process; models load once.
+
+Pick the engine with config.json -> ocr.engine ("tesseract" | "rapidocr").
+The WECHAT4_OCR_ENGINE environment variable overrides the config, which lets a
+test script compare engines without editing config.json.
+
+Both engines record call counts and time so a run can report how much of its
+elapsed time went to OCR.
+"""
+import hashlib
+import os
+import subprocess
+import threading
+import time
+
+import cv2
+import numpy as np
+
+BASE_DIR = os.path.dirname(os.path.abspath(__file__))
+ENGINES = ("tesseract", "rapidocr")
+ENV_ENGINE = "WECHAT4_OCR_ENGINE"
+ENV_DET_MODEL = "WECHAT4_RAPIDOCR_DET"
+ENV_REC_MODEL = "WECHAT4_RAPIDOCR_REC"
+_NO_WINDOW = 0x08000000 if os.name == "nt" else 0
+_CACHE_MAX = 64
+
+_lock = threading.Lock()
+_init_lock = threading.Lock()
+_cfg = {}
+_rapid = None
+_rapid_error = ""
+_cache = {}
+_stats = {"calls": 0, "ms": 0.0, "initMs": 0.0, "cacheHits": 0, "errors": 0}
+
+
+class OCREngineError(RuntimeError):
+    """The selected OCR engine cannot be loaded."""
+
+
+def configure(ocr_cfg):
+    """Use the `ocr` section of config.json. Safe to call repeatedly."""
+    global _cfg
+    _cfg = dict(ocr_cfg or {}) if isinstance(ocr_cfg, dict) else {}
+
+
+def engine():
+    name = os.environ.get(ENV_ENGINE, "") or _cfg.get("engine", "") or "tesseract"
+    name = str(name).strip().lower()
+    return name if name in ENGINES else "tesseract"
+
+
+def is_rapid():
+    return engine() == "rapidocr"
+
+
+def rapid_option(key, default=None):
+    rc = _cfg.get("rapidocr") or {}
+    value = rc.get(key) if isinstance(rc, dict) else None
+    return default if value in (None, "") else value
+
+
+def last_error():
+    return _rapid_error
+
+
+def stats():
+    with _lock:
+        out = dict(_stats)
+    out["engine"] = engine()
+    out["ms"] = int(round(out["ms"]))
+    out["initMs"] = int(round(out["initMs"]))
+    if _rapid_error:
+        out["error"] = _rapid_error
+    return out
+
+
+def clear_cache():
+    """Forget cached results (each new screenshot should be recognized afresh)."""
+    with _lock:
+        _cache.clear()
+
+
+def _record(t0):
+    with _lock:
+        _stats["calls"] += 1
+        _stats["ms"] += (time.perf_counter() - t0) * 1000.0
+
+
+# ─────────────── Tesseract ───────────────
+
+def run_tesseract(cmd, timeout):
+    """subprocess.run for a tesseract command line, timed for stats()."""
+    t0 = time.perf_counter()
+    try:
+        return subprocess.run(cmd, capture_output=True, timeout=timeout,
+                              creationflags=_NO_WINDOW)
+    finally:
+        _record(t0)
+
+
+# ─────────────── RapidOCR ───────────────
+
+def _model_path(env_key, cfg_key):
+    path = os.environ.get(env_key, "") or rapid_option(cfg_key, "")
+    if not path:
+        return ""
+    path = os.path.expandvars(str(path))
+    if not os.path.isabs(path):
+        path = os.path.join(BASE_DIR, path)
+    return path
+
+
+def _rapid_params():
+    params = {"Global.use_cls": False, "Global.log_level": "warning"}
+    det = _model_path(ENV_DET_MODEL, "detModel")
+    rec = _model_path(ENV_REC_MODEL, "recModel")
+    for path in (det, rec):
+        if path and not os.path.isfile(path):
+            raise OCREngineError("model file not found: %s" % path)
+    if det:
+        params["Det.model_path"] = det
+    if rec:
+        params["Rec.model_path"] = rec
+    threads = int(rapid_option("threads", 0) or 0)
+    if threads > 0:
+        params["EngineConfig.onnxruntime.intra_op_num_threads"] = threads
+    for key, dst in (("detLimitSideLen", "Det.limit_side_len"),
+                     ("detLimitType", "Det.limit_type"),
+                     ("textScore", "Global.text_score")):
+        value = rapid_option(key)
+        if value is not None:
+            params[dst] = value
+    return params
+
+
+def _get_rapid():
+    """Load RapidOCR once per process; raise OCREngineError if it cannot load."""
+    global _rapid, _rapid_error
+    if _rapid is not None:
+        return _rapid
+    with _init_lock:
+        if _rapid is not None:
+            return _rapid
+        if _rapid_error:
+            raise OCREngineError(_rapid_error)
+        t0 = time.perf_counter()
+        try:
+            from rapidocr import RapidOCR
+            _rapid = RapidOCR(params=_rapid_params())
+        except OCREngineError as exc:
+            _rapid_error = str(exc)
+            raise
+        except Exception as exc:
+            _rapid_error = "rapidocr unavailable: %s: %s" % (type(exc).__name__, exc)
+            raise OCREngineError(_rapid_error)
+        finally:
+            with _lock:
+                _stats["initMs"] += (time.perf_counter() - t0) * 1000.0
+    return _rapid
+
+
+def _as_bgr(img):
+    """PIL image, RGB array or grayscale array -> contiguous BGR array."""
+    arr = np.asarray(img)
+    if arr.ndim == 2:
+        arr = cv2.cvtColor(arr, cv2.COLOR_GRAY2BGR)
+    elif arr.ndim == 3 and arr.shape[2] == 4:
+        arr = cv2.cvtColor(arr, cv2.COLOR_RGBA2BGR)
+    elif arr.ndim == 3 and arr.shape[2] == 3:
+        arr = cv2.cvtColor(arr, cv2.COLOR_RGB2BGR)
+    return np.ascontiguousarray(arr, dtype=np.uint8)
+
+
+def rapid_lines(img, detect=True):
+    """Run RapidOCR on an image region.
+
+    detect=True finds text boxes first and returns one entry per box.
+    detect=False recognizes the whole image as one text line.
+    Returns [{text, score, x0, y0, x1, y1}] in the input image's pixels.
+    Model load failures raise OCREngineError; per-call failures return [].
+    """
+    arr = _as_bgr(img)
+    h, w = arr.shape[:2]
+    if h < 4 or w < 4:
+        return []
+    key = (bool(detect), arr.shape, hashlib.blake2b(arr.tobytes(), digest_size=16).digest())
+    with _lock:
+        cached = _cache.get(key)
+        if cached is not None:
+            _stats["cacheHits"] += 1
+            return [dict(x) for x in cached]
+    ocr = _get_rapid()
+    t0 = time.perf_counter()
+    try:
+        res = ocr(arr, use_det=bool(detect), use_cls=False, use_rec=True)
+        lines = _parse_result(res, w, h, detect)
+    except Exception:
+        with _lock:
+            _stats["errors"] += 1
+        return []
+    finally:
+        _record(t0)
+    with _lock:
+        if len(_cache) >= _CACHE_MAX:
+            _cache.clear()
+        _cache[key] = [dict(x) for x in lines]
+    return lines
+
+
+def _parse_result(res, w, h, detect):
+    txts = list(getattr(res, "txts", None) or ())
+    scores = list(getattr(res, "scores", None) or ())
+    boxes = getattr(res, "boxes", None) if detect else None
+    lines = []
+    for i, text in enumerate(txts):
+        text = " ".join(str(text or "").split())
+        if not text:
+            continue
+        if boxes is not None and i < len(boxes):
+            pts = np.asarray(boxes[i], dtype=float).reshape(-1, 2)
+            x0, y0 = float(pts[:, 0].min()), float(pts[:, 1].min())
+            x1, y1 = float(pts[:, 0].max()), float(pts[:, 1].max())
+        else:
+            x0, y0, x1, y1 = 0.0, 0.0, float(w), float(h)
+        score = float(scores[i]) if i < len(scores) else 0.0
+        lines.append({"text": text, "score": score,
+                      "x0": x0, "y0": y0, "x1": x1, "y1": y1})
+    return lines
+
+
+def join_lines(lines):
+    """Join boxes in reading order: rows top to bottom, boxes left to right."""
+    rows = []
+    for ln in sorted(lines, key=lambda d: (d["y0"] + d["y1"]) / 2.0):
+        cy = (ln["y0"] + ln["y1"]) / 2.0
+        hh = max(1.0, ln["y1"] - ln["y0"])
+        for row in rows:
+            if abs(row["cy"] - cy) <= 0.5 * max(hh, row["h"]):
+                row["items"].append(ln)
+                break
+        else:
+            rows.append({"cy": cy, "h": hh, "items": [ln]})
+    parts = []
+    for row in rows:
+        parts.extend(d["text"] for d in sorted(row["items"], key=lambda d: d["x0"]))
+    return " ".join(parts)
+
+
+def rapid_text(img, single_line=False):
+    """Text of a region as one string, matching what callers get from tesseract stdout."""
+    return join_lines(rapid_lines(img, detect=not single_line))
