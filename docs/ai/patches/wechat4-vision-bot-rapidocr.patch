+++ b/tools/ocr_bench.py
@@ -0,0 +1,217 @@
+# -*- coding: utf-8 -*-
+"""Compare OCR engines on saved WeChat window screenshots (offline, read-only).
+
+Each variant runs in a fresh Python process, like a real `reply.py --read-msg`,
+so model loading counts toward its first image. Each process OCRs the chat title
+and the incoming bubbles with the same reply.py functions the read path uses.
+
+Collect screenshots with `reply.py --read-msg --chat "Test" --save-shot`. The JSON
+output gives the screenshot path and the window's DPI scale.
+
+  .venv\\Scripts\\python.exe tools\\ocr_bench.py screenshots\\*-read.png
+  .venv\\Scripts\\python.exe tools\\ocr_bench.py --variants tesseract,rapidocr,v5mobile,v6tiny ^
+      --scale 1.25 --repeat 3 screenshots\\*-read.png
+
+Variants: tesseract; rapidocr (PP-OCRv6 small bundled in the rapidocr wheel);
+v5mobile and v6tiny (model files under models\\, see MODEL_PRESETS).
+Nothing is clicked or typed; screenshots are only read.
+"""
+import argparse
+import glob
+import json
+import os
+import subprocess
+import sys
+import time
+
+BOT_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+MARK = "@@OCR_BENCH@@"
+MODEL_PRESETS = {
+    "tesseract": {"engine": "tesseract"},
+    "rapidocr": {"engine": "rapidocr"},
+    "v5mobile": {"engine": "rapidocr",
+                 "det": "models/ch_PP-OCRv5_det_mobile.onnx",
+                 "rec": "models/ch_PP-OCRv5_rec_mobile.onnx"},
+    "v6tiny": {"engine": "rapidocr",
+               "det": "models/PP-OCRv6_det_tiny.onnx",
+               "rec": "models/PP-OCRv6_rec_tiny.onnx"},
+}
+
+
+class BenchCtx:
+    """Stand-in for reply.Ctx: no deadline, no input guard, no waiting."""
+    step = "bench"
+
+    def check(self):
+        pass
+
+    def checkpoint(self, *_args, **_kwargs):
+        pass
+
+    def sleep(self, _seconds):
+        pass
+
+
+def run_child(args):
+    t0 = time.perf_counter()
+    sys.path.insert(0, BOT_DIR)
+    os.chdir(BOT_DIR)
+    import ocr_engine
+    import reply
+    from PIL import Image
+
+    logs = []
+    reply.log = lambda msg: logs.append(str(msg))  # keep bench lines out of logs/watchdog-*.log
+    ocr_engine.configure(reply.watcher.load_config().get("ocr"))
+    import_ms = (time.perf_counter() - t0) * 1000.0
+    ctx = BenchCtx()
+    results = []
+    for rnd in range(args.repeat):
+        for path in args.images:
+            img = Image.open(path).convert("RGB")
+            ocr_engine.clear_cache()  # no reuse across images or rounds
+            geom = reply.geom_of(img, args.scale)
+            item = {"round": rnd, "image": path}
+            t = time.perf_counter()
+            try:
+                item["title"] = reply.ocr_chat_title(img, geom, ctx)
+            except Exception as exc:
+                item["title"] = ""
+                item["error"] = "%s: %s" % (type(exc).__name__, exc)
+            item["titleMs"] = int((time.perf_counter() - t) * 1000)
+            t = time.perf_counter()
+            try:
+                res = reply.read_chat_incoming_bubbles(ctx, img, geom, max_bubbles=args.max_bubbles)
+                item["bubbles"] = [b.get("text", "") for b in (res.get("bubbles") or [])]
+            except Exception as exc:
+                item["bubbles"] = []
+                item["error"] = "%s: %s" % (type(exc).__name__, exc)
+            item["readMs"] = int((time.perf_counter() - t) * 1000)
+            results.append(item)
+    out = {"importMs": int(import_ms), "results": results, "stats": ocr_engine.stats()}
+    if args.verbose:
+        out["log"] = logs[-200:]
+    print(MARK + json.dumps(out, ensure_ascii=False), flush=True)
+    return 0
+
+
+def expand_images(patterns):
+    files = []
+    for pat in patterns:
+        hits = sorted(glob.glob(pat)) or ([pat] if os.path.isfile(pat) else [])
+        files.extend(os.path.abspath(h) for h in hits)
+    return list(dict.fromkeys(files))
+
+
+def run_variant(name, args, images):
+    preset = MODEL_PRESETS.get(name)
+    if preset is None:
+        return {"variant": name, "error": "unknown variant (choose from %s)" % ", ".join(MODEL_PRESETS)}
+    env = dict(os.environ)
+    env["WECHAT4_OCR_ENGINE"] = preset["engine"]
+    env.pop("WECHAT4_RAPIDOCR_DET", None)
+    env.pop("WECHAT4_RAPIDOCR_REC", None)
+    for key, var in (("det", "WECHAT4_RAPIDOCR_DET"), ("rec", "WECHAT4_RAPIDOCR_REC")):
+        if preset.get(key):
+            path = os.path.join(BOT_DIR, preset[key])
+            if not os.path.isfile(path):
+                return {"variant": name, "error": "model file missing: %s" % path}
+            env[var] = path
+    cmd = [sys.executable, os.path.abspath(__file__), "--child",
+           "--scale", str(args.scale), "--repeat", str(args.repeat),
+           "--max-bubbles", str(args.max_bubbles)]
+    if args.verbose:
+        cmd.append("--verbose")
+    cmd.extend(images)
+    t = time.perf_counter()
+    try:
+        proc = subprocess.run(cmd, cwd=BOT_DIR, env=env, capture_output=True, text=True,
+                              encoding="utf-8", errors="replace", timeout=args.timeout)
+    except subprocess.TimeoutExpired:
+        return {"variant": name, "error": "timeout after %.0fs" % args.timeout}
+    wall_ms = int((time.perf_counter() - t) * 1000)
+    for line in reversed(proc.stdout.splitlines()):
+        if line.startswith(MARK):
+            data = json.loads(line[len(MARK):])
+            data.update({"variant": name, "wallMs": wall_ms})
+            return data
+    tail = (proc.stderr or proc.stdout or "").strip().splitlines()[-5:]
+    return {"variant": name, "wallMs": wall_ms, "error": "child exit %s: %s" % (proc.returncode, " | ".join(tail))}
+
+
+def summarize(data):
+    res = data.get("results") or []
+    per_image = [r["titleMs"] + r["readMs"] for r in res]
+    later = per_image[1:]
+    st = data.get("stats") or {}
+    return {
+        "wallMs": data.get("wallMs"),
+        "importMs": data.get("importMs"),
+        "initMs": st.get("initMs"),
+        "firstMs": per_image[0] if per_image else None,
+        "laterAvgMs": int(sum(later) / len(later)) if later else None,
+        "ocrCalls": st.get("calls"),
+        "ocrMs": st.get("ms"),
+        "errors": sum(1 for r in res if r.get("error")) + int(st.get("errors") or 0),
+    }
+
+
+def print_report(runs, images):
+    cols = ["wallMs", "importMs", "initMs", "firstMs", "laterAvgMs", "ocrCalls", "ocrMs", "errors"]
+    print("\n== 耗时（毫秒）：wall=整个子进程；first=第一张图（含模型首次加载）；laterAvg=其余平均 ==")
+    print("%-10s " % "variant" + " ".join("%10s" % c for c in cols))
+    for run in runs:
+        if run.get("error"):
+            print("%-10s %s" % (run["variant"], run["error"]))
+            continue
+        s = summarize(run)
+        print("%-10s " % run["variant"] + " ".join("%10s" % ("-" if s[c] is None else s[c]) for c in cols))
+    print("\n== 识别结果（第一轮）==")
+    for path in images:
+        print("\n# %s" % os.path.basename(path))
+        for run in runs:
+            if run.get("error"):
+                continue
+            first = next((r for r in run["results"] if r["image"] == path and r["round"] == 0), None)
+            if first is None:
+                continue
+            print("  %-10s 标题=%r" % (run["variant"], first.get("title", "")))
+            print("  %-10s 气泡=%r%s" % ("", first.get("bubbles", []),
+                                        ("  错误=" + first["error"]) if first.get("error") else ""))
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description="Offline OCR engine comparison on WeChat screenshots")
+    ap.add_argument("images", nargs="+", help="PNG screenshots of the WeChat window (globs allowed)")
+    ap.add_argument("--variants", default="tesseract,rapidocr",
+                    help="comma list from: %s" % ", ".join(MODEL_PRESETS))
+    ap.add_argument("--scale", type=float, default=1.0, help="window DPI scale (1.0 = 100%%, 1.25 = 125%%)")
+    ap.add_argument("--repeat", type=int, default=2, help="passes over all images per process")
+    ap.add_argument("--max-bubbles", type=int, default=3)
+    ap.add_argument("--timeout", type=float, default=900.0, help="seconds per variant process")
+    ap.add_argument("--out", default="", help="write the full JSON report here")
+    ap.add_argument("--verbose", action="store_true", help="keep reply.py log lines in the report")
+    ap.add_argument("--child", action="store_true", help=argparse.SUPPRESS)
+    args = ap.parse_args(argv)
+    try:
+        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
+    except Exception:
+        pass
+    if args.child:
+        return run_child(args)
+    images = expand_images(args.images)
+    if not images:
+        print("没有找到截图: %s" % " ".join(args.images))
+        return 2
+    runs = [run_variant(v.strip(), args, images) for v in args.variants.split(",") if v.strip()]
+    print_report(runs, images)
+    if args.out:
+        with open(args.out, "w", encoding="utf-8") as f:
+            json.dump({"images": images, "scale": args.scale, "repeat": args.repeat, "runs": runs},
+                      f, ensure_ascii=False, indent=2)
+        print("\n报告: %s" % os.path.abspath(args.out))
+    return 1 if any(r.get("error") for r in runs) else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
